<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper.emp.dynamic">

	<select id="selectEmp" resultType="kr.or.human.dto.EmpDTO">
		select * from emp2
	</select>

	<select id="searchEmp" resultType="empDTO" parameterType="empDTO">
		select * from emp2
		<if test=" ename != null and ename != '' ">
			where upper(ename) like upper('%' || #{ename} || '%')
		</if>
<!-- 		<if test=" sal != -1 "> -->
<!-- 			where sal  <![CDATA[ >=  ]]> #{sal} -->
<!-- 		</if> -->

<!-- 		where 태그는 if가 true일때 글자 'where' 로 변환됨 -->
<!-- 		그리고 if가 true가 여러개이면 첫번째오는 AND 또는 OR 를 지워줌  -->
<!-- 		<where> -->
<!-- 			and !#@!@#$ -->
<!-- 		</where> -->
	</select>



</mapper>